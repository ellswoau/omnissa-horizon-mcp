# Copy to .env and fill in. NEVER commit the password or token.
HORIZON_BASE_URL=https://horizon.example.com
HORIZON_DOMAIN=EXAMPLE
HORIZON_USERNAME=svc-horizon-mcp
HORIZON_PASSWORD=
HORIZON_VERIFY_SSL=true
HORIZON_TIMEOUT=30
# Bearer token that gates the network MCP endpoints (empty = auth disabled).
# Generate with: openssl rand -hex 32
HORIZON_MCP_AUTH_TOKEN=
# HORIZON_CONFIG_FILE=./horizon.json

# Optional: extra connection servers (multi-site / DR), as a JSON array.
# Entries inherit HORIZON_USERNAME/PASSWORD/DOMAIN unless they override them.
# Example: primary = cloud, DR = cloud-b
# HORIZON_SITES=[{"name":"primary","base_url":"https://cloud.wellertruck.com","role":"primary"},{"name":"secondary","base_url":"https://cloud-b.wellertruck.com","role":"secondary"}]